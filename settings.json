{
    "workbench.colorTheme": "SynthWave '84",

    // =========================================================
    // ⚡ SYNTHWAVE '84 — NEON OVERDRIVE
    // =========================================================

    "synthwave84.enableGlow": true,

    // =========================================================
    // 🧠 EDITOR
    // =========================================================

    "editor.fontSize": 15,
    "editor.fontWeight": "500",
    "editor.lineHeight": 1.5,
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 3,
    "editor.cursorBlinking": "smooth",
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "selection",
    "editor.minimap.enabled": true,
    "editor.minimap.renderCharacters": true,
    "editor.minimap.maxColumn": 120,
    "editor.minimap.showSlider": "always",
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.highlightActiveIndentation": true,

    // =========================================================
    // 🌈 INTERFACE — NEON BLUE
    // =========================================================

    "workbench.colorCustomizations": {

        "editor.background": "#07030D",
        "editor.foreground": "#F7EFFF",

        "editorCursor.foreground": "#00F6FF",
        "editor.lineHighlightBackground": "#180A2A",
        "editor.lineHighlightBorder": "#00F6FF55",

        "editor.selectionBackground": "#0066FF66",
        "editor.inactiveSelectionBackground": "#0055AA44",

        "editor.findMatchBackground": "#00BFFF",
        "editor.findMatchHighlightBackground": "#00F6FF55",

        "editor.wordHighlightBackground": "#00BFFF33",
        "editor.wordHighlightStrongBackground": "#00F6FF44",

        // INDENTAÇÃO

        "editorIndentGuide.background1": "#0066FF44",
        "editorIndentGuide.activeBackground1": "#00F6FF",

        // BRACKETS

        "editorBracketHighlight.foreground1": "#00F6FF",
        "editorBracketHighlight.foreground2": "#009DFF",
        "editorBracketHighlight.foreground3": "#45C4FF",
        "editorBracketHighlight.foreground4": "#00BFFF",
        "editorBracketHighlight.foreground5": "#39FF14",
        "editorBracketHighlight.foreground6": "#008CFF",
        "editorBracketHighlight.unexpectedBracket.foreground": "#FF1744",

        // ABAS

        "editorGroupHeader.tabsBackground": "#050209",
        "editorGroupHeader.noTabsBackground": "#050209",

        "tab.activeBackground": "#0A1630",
        "tab.activeForeground": "#00F6FF",
        "tab.activeBorder": "#00BFFF",
        "tab.activeBorderTop": "#00F6FF",

        "tab.inactiveBackground": "#09040F",
        "tab.inactiveForeground": "#5280A8",

        "tab.unfocusedActiveBackground": "#0B1424",
        "tab.unfocusedActiveForeground": "#45C4FF",

        "tab.border": "#0066FF66",
        "editorGroup.border": "#0066FF",

        // EXPLORER

        "sideBar.background": "#06030B",
        "sideBar.foreground": "#00D9FF",
        "sideBar.border": "#0066FF",

        "sideBarSectionHeader.background": "#071326",
        "sideBarSectionHeader.foreground": "#00F6FF",
        "sideBarSectionHeader.border": "#00BFFF66",

        // LISTAS

        "list.activeSelectionBackground": "#082A4F",
        "list.activeSelectionForeground": "#00F6FF",

        "list.inactiveSelectionBackground": "#0B1D35",
        "list.inactiveSelectionForeground": "#45C4FF",

        "list.hoverBackground": "#09213A",
        "list.hoverForeground": "#00F6FF",

        "list.focusBackground": "#0B2948",
        "list.focusForeground": "#00F6FF",

        "list.highlightForeground": "#00BFFF",

        // ACTIVITY BAR

        "activityBar.background": "#030208",
        "activityBar.foreground": "#00F6FF",
        "activityBar.inactiveForeground": "#526D88",
        "activityBar.activeBorder": "#00F6FF",
        "activityBar.border": "#0066FF",

        "activityBarBadge.background": "#00BFFF",
        "activityBarBadge.foreground": "#FFFFFF",

        // STATUS BAR

        "statusBar.background": "#061020",
        "statusBar.foreground": "#00F6FF",
        "statusBar.border": "#00BFFF",

        "statusBarItem.hoverBackground": "#0A2945",
        "statusBarItem.activeBackground": "#0B3D66",

        "statusBar.debuggingBackground": "#06253A",
        "statusBar.debuggingForeground": "#00F6FF",

        // TERMINAL

        "terminal.background": "#030208",
        "terminal.foreground": "#00F6FF",
        "terminalCursor.foreground": "#00F6FF",
        "terminal.border": "#00BFFF",

        "terminal.selectionBackground": "#0066FF66",

        "terminal.ansiBlack": "#09040F",
        "terminal.ansiRed": "#FF1744",
        "terminal.ansiGreen": "#39FF14",
        "terminal.ansiYellow": "#FFEA00",
        "terminal.ansiBlue": "#009DFF",
        "terminal.ansiMagenta": "#008CFF",
        "terminal.ansiCyan": "#00F6FF",
        "terminal.ansiWhite": "#F7EFFF",

        "terminal.ansiBrightBlack": "#52708A",
        "terminal.ansiBrightRed": "#FF4569",
        "terminal.ansiBrightGreen": "#6CFF4A",
        "terminal.ansiBrightYellow": "#FFF45C",
        "terminal.ansiBrightBlue": "#45C4FF",
        "terminal.ansiBrightMagenta": "#45C4FF",
        "terminal.ansiBrightCyan": "#66FFFF",
        "terminal.ansiBrightWhite": "#FFFFFF",

        // PAINÉIS

        "panel.background": "#06030B",
        "panel.border": "#0066FF",

        "panelTitle.activeForeground": "#00F6FF",
        "panelTitle.inactiveForeground": "#5280A8",
        "panelTitle.activeBorder": "#00BFFF",

        // INPUTS

        "input.background": "#071326",
        "input.foreground": "#00F6FF",
        "input.border": "#0066FF",

        "inputOption.activeBorder": "#00F6FF",
        "inputOption.activeBackground": "#082A4F",

        // BOTÕES

        "button.background": "#0066FF",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#00BFFF",

        "button.secondaryBackground": "#081A30",
        "button.secondaryForeground": "#00F6FF",

        // BADGES

        "badge.background": "#00BFFF",
        "badge.foreground": "#FFFFFF",

        // TITLE BAR

        "titleBar.activeBackground": "#050209",
        "titleBar.activeForeground": "#00F6FF",

        "titleBar.inactiveBackground": "#030208",
        "titleBar.inactiveForeground": "#526D88",

        "titleBar.border": "#0066FF",

        // FOCUS

        "focusBorder": "#00F6FF",
        "widget.border": "#00BFFF",
        "widget.shadow": "#00F6FF55",

        // SCROLLBAR

        "scrollbarSlider.background": "#0066FF55",
        "scrollbarSlider.hoverBackground": "#00F6FF88",
        "scrollbarSlider.activeBackground": "#00F6FF99",

        // PEEK

        "peekView.border": "#00F6FF",
        "peekViewEditor.background": "#0B0412",
        "peekViewResult.background": "#071326",
        "peekViewTitle.background": "#0A1B30",

        // DEBUG

        "debugToolBar.background": "#061426",
        "debugToolBar.border": "#00F6FF",

        // NOTIFICAÇÕES

        "notifications.background": "#0B0412",
        "notifications.foreground": "#00F6FF",
        "notifications.border": "#00BFFF",

        // QUICK INPUT

        "quickInput.background": "#071326",
        "quickInput.foreground": "#00F6FF",
        "quickInputTitle.background": "#0A1B30",

        // LINKS

        "textLink.foreground": "#00F6FF",
        "textLink.activeForeground": "#45C4FF",

        // GIT

        "gitDecoration.modifiedResourceForeground": "#00F6FF",
        "gitDecoration.addedResourceForeground": "#39FF14",
        "gitDecoration.deletedResourceForeground": "#FF1744",
        "gitDecoration.untrackedResourceForeground": "#FFEA00",
        "gitDecoration.ignoredResourceForeground": "#52708A",
        "gitDecoration.conflictingResourceForeground": "#009DFF"
    },

    // =========================================================
    // 💙 CÓDIGO — BLUE NEON
    // =========================================================

    "editor.tokenColorCustomizations": {
        "[SynthWave '84]": {

            "textMateRules": [

                // KEYWORDS

                {
                    "scope": [
                        "keyword",
                        "keyword.control",
                        "keyword.operator",
                        "storage",
                        "storage.type"
                    ],
                    "settings": {
                        "foreground": "#00BFFF"
                    }
                },

                // FUNÇÕES

                {
                    "scope": [
                        "entity.name.function",
                        "support.function",
                        "variable.function"
                    ],
                    "settings": {
                        "foreground": "#00F6FF"
                    }
                },

                // TIPOS / CLASSES

                {
                    "scope": [
                        "entity.name.type",
                        "support.type",
                        "entity.name.class"
                    ],
                    "settings": {
                        "foreground": "#39CFFF"
                    }
                },

                // STRINGS

                {
                    "scope": [
                        "string",
                        "string.quoted",
                        "string.template"
                    ],
                    "settings": {
                        "foreground": "#00FFFF"
                    }
                },

                // NÚMEROS

                {
                    "scope": [
                        "constant.numeric",
                        "constant.language"
                    ],
                    "settings": {
                        "foreground": "#4D9FFF"
                    }
                },

                // VARIÁVEIS

                {
                    "scope": [
                        "variable",
                        "variable.other.readwrite",
                        "variable.other.constant"
                    ],
                    "settings": {
                        "foreground": "#B8F6FF"
                    }
                },

                // COMENTÁRIOS

                {
                    "scope": [
                        "comment",
                        "punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#5C8DB8"
                    }
                },

                // HTML TAGS

                {
                    "scope": [
                        "entity.name.tag"
                    ],
                    "settings": {
                        "foreground": "#009DFF"
                    }
                },

                // HTML ATRIBUTOS

                {
                    "scope": [
                        "entity.other.attribute-name"
                    ],
                    "settings": {
                        "foreground": "#00E5FF"
                    }
                },

                // PONTUAÇÃO

                {
                    "scope": [
                        "punctuation",
                        "punctuation.definition",
                        "meta.brace"
                    ],
                    "settings": {
                        "foreground": "#6AC8FF"
                    }
                },

                // =================================================
                // SQL
                // =================================================

                {
                    "scope": [
                        "keyword.sql",
                        "keyword.other.sql",
                        "keyword.control.sql",
                        "storage.type.sql"
                    ],
                    "settings": {
                        "foreground": "#00BFFF"
                    }
                },

                {
                    "scope": [
                        "entity.name.function.sql",
                        "support.function.sql"
                    ],
                    "settings": {
                        "foreground": "#00F6FF"
                    }
                },

                {
                    "scope": [
                        "support.type.sql",
                        "storage.type.sql",
                        "entity.name.type.sql"
                    ],
                    "settings": {
                        "foreground": "#39CFFF"
                    }
                },

                {
                    "scope": [
                        "variable.other.sql",
                        "variable.parameter.sql",
                        "variable.other.readwrite.sql"
                    ],
                    "settings": {
                        "foreground": "#B8F6FF"
                    }
                },

                {
                    "scope": [
                        "entity.name.table.sql",
                        "entity.name.column.sql",
                        "entity.name.schema.sql",
                        "entity.name.database.sql"
                    ],
                    "settings": {
                        "foreground": "#00D9FF"
                    }
                },

                {
                    "scope": [
                        "constant.numeric.sql"
                    ],
                    "settings": {
                        "foreground": "#4D9FFF"
                    }
                },

                {
                    "scope": [
                        "string.quoted.sql",
                        "string.sql"
                    ],
                    "settings": {
                        "foreground": "#00FFFF"
                    }
                }
            ]
        }
    },

    // =========================================================
    // 💻 TERMINAL
    // =========================================================

    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontWeight": "500",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.minimumContrastRatio": 1,

    // =========================================================
    // ✨ INTERFACE
    // =========================================================

    "workbench.iconTheme": "material-icon-theme",
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "always",
    "explorer.compactFolders": false,

    "breadcrumbs.enabled": true,
    "breadcrumbs.icons": true,

    // =========================================================
    // 🖥️ JANELA
    // =========================================================

    "window.commandCenter": true,
    "window.title": "${activeEditorShort}${separator}${rootName} ⚡ NEON",
    "workbench.startupEditor": "none",

    // =========================================================
    // ⚙️ ORGANIZAÇÃO
    // =========================================================

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // =========================================================
    // 🚀 PERFORMANCE
    // =========================================================

    "editor.stickyScroll.enabled": true,
    "workbench.list.smoothScrolling": true,
    "debug.console.fontSize": 14
}